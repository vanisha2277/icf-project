# Example environment variables for the ICF Project backend
# Do NOT put real API keys here. Copy to .env and populate locally.

# Required for POST /simplify and POST /define-word
ANTHROPIC_API_KEY=

# Optional. Default is claude-haiku-4-5 (fast enough for the 8s per-call timeout).
ANTHROPIC_MODEL=

# Legacy names still accepted as a fallback for the API key only
AI_PROVIDER=
AI_API_KEY=
